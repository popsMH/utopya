<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="pos_session_sales_details_uto" inherit_id="point_of_sale.pos_session_sales_details">

            <!-- Action 1: Title -->
            <xpath expr="//h2[@id='daily_report_title']" position="replace">
                <h2 t-if="state == 'closed' or state == 'opened'" id="daily_report_title">
                    <t t-if="state == 'closed'">Sales Report</t>
                    <t t-else="">Current Sales Report</t>
                </h2>
            </xpath>

            <!-- Action 1: Date "As of MM/DD/YYYY" → "As of DD/MM/YYYY" -->
            <xpath expr="//span[contains(@class,'badge')]/strong" position="replace">
                <strong>As of&#160;<span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></strong>
            </xpath>

            <!-- Sections -->
            <xpath expr="//div[@id='sales']/h6" position="replace">
                <h6 class="bg-secondary p-1 fw-bold">Sales</h6>
            </xpath>

            <xpath expr="//div[@id='taxe_sales']/h6" position="replace">
                <h6 class="bg-secondary p-1 fw-bold w-50 ms-auto">VAT on Sales</h6>
            </xpath>

            <xpath expr="//div[@id='refunds']/h6" position="replace">
                <h6 class="bg-secondary p-1 fw-bold">Credit Notes / Refunds</h6>
            </xpath>

            <xpath expr="//div[@id='taxe_refunds']/h6" position="replace">
                <h6 class="bg-secondary p-1 fw-bold w-50 ms-auto">VAT on Credit Notes</h6>
            </xpath>

            <xpath expr="//t[@id='other_payments']/h6" position="replace">
                <h6 class="bg-secondary p-1 fw-bold w-50 ms-auto">Payments</h6>
            </xpath>

            <xpath expr="//t[@id='closing_session']/h6" position="replace">
                <h6 class="bg-secondary p-1 fw-bold">Session Control</h6>
            </xpath>

            <xpath expr="//div[@id='discounts']/h6" position="replace">
                <h6 class="bg-secondary p-1 fw-bold">Discounts</h6>
            </xpath>

            <!-- Discounts: labels -->
            <xpath expr="//div[@id='discounts']//div[@class='row'][1]//strong" position="replace">
                <strong>Number of Discounts</strong>
            </xpath>

            <xpath expr="//div[@id='discounts']//div[@class='row'][2]//strong" position="replace">
                <strong>Discount Amount</strong>
            </xpath>

            <!-- Session control table: column headers -->
            <xpath expr="//t[@id='closing_session']//thead/tr" position="replace">
                <tr>
                    <th class="text-start">Label</th>
                    <th/>
                    <th class="text-end">Expected</th>
                    <th t-if="(state == 'closed' or state == 'multiple') and payments" class="text-end">Counted</th>
                    <th t-if="(state == 'closed' or state == 'multiple') and payments" class="text-end">Difference</th>
                </tr>
            </xpath>

            <!-- Session control: "Number of transactions" -->
            <xpath expr="//t[@id='closing_session']//strong[span[@t-out='nbr_orders']]" position="replace">
                <strong>Number of transactions: <span t-out="nbr_orders">10</span></strong>
            </xpath>

            <!-- Opening / closing notes -->
            <xpath expr="//span[@id='opening_note']/strong" position="replace">
                <strong>Opening note:</strong>
            </xpath>

            <xpath expr="//span[@id='closing_note']/strong" position="replace">
                <strong>Closing note:</strong>
            </xpath>

        </template>
    </data>
</odoo>
