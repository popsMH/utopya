<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- =====================================================
             POS categories — 4 business lines, 4 distinct colors
             color int → CSS class o_colorlist_item_color_transparent_N
             8=dark blue · 4=teal · 2=orange · 9=mint green
             ===================================================== -->

        <record id="pos_category_device" model="pos.category">
            <field name="name">Devices</field>
            <field name="color">8</field>
            <field name="sequence">1</field>
        </record>

        <record id="pos_category_accessory" model="pos.category">
            <field name="name">Accessoires</field>
            <field name="color">4</field>
            <field name="sequence">2</field>
        </record>

        <record id="pos_category_spare_part" model="pos.category">
            <field name="name">Pièces Détachées</field>
            <field name="color">2</field>
            <field name="sequence">3</field>
        </record>

        <record id="pos_category_labor" model="pos.category">
            <field name="name">Main d'œuvre &amp; Forfaits</field>
            <field name="color">9</field>
            <field name="sequence">4</field>
        </record>

        <!-- Configure the POS: permanent category bar with the 4 categories -->
        <function model="pos.config" name="_uto_configure_pos_categories"/>

    </data>
</odoo>
