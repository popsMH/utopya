<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="uto_pos.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">

        <!-- 1. Cash block title: payment method name → "Cash" -->
        <xpath expr="//div[contains(@class,'payment-methods-overview')]/div[@t-if='pos.config.cash_control']/div[contains(@class,'fs-3')]/span[@t-esc='props.default_cash_details.name']" position="replace">
            <span>Cash</span>
        </xpath>

        <!-- 2. Hide Customer Account in the summary (pay_later type) -->
        <xpath expr="//div[@t-foreach='props.non_cash_payment_methods'][@t-as='pm'][t[@t-set='diff']]" position="attributes">
            <attribute name="t-if">pm.type !== 'pay_later'</attribute>
        </xpath>

        <!-- 3. Card payment method name: "pm.name" → "Credit Card (CB)" for bank type -->
        <xpath expr="//div[@t-foreach='props.non_cash_payment_methods'][@t-as='pm'][t[@t-set='diff']]/div[contains(@class,'fs-3')]/span[@t-esc='pm.name']" position="replace">
            <span t-if="pm.type === 'bank'">Credit Card (CB)</span>
            <span t-else="" t-esc="pm.name" />
        </xpath>

        <!-- 4. QualiRépar block (after the payment methods, before the separator) -->
        <xpath expr="//div[contains(@class,'payment-methods-overview')]" position="inside">
            <div class="w-100 mb-3" t-if="qualiReparState.loaded and qualiReparState.configured">
                <div class="d-flex align-items-center justify-content-between fs-3">
                    <span>QualiRépar Bonus</span>
                    <span t-esc="env.utils.formatCurrency(qualiReparState.total)" />
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                    <span>Total granted today</span>
                    <span t-esc="env.utils.formatCurrency(qualiReparState.total)" />
                </div>
            </div>
        </xpath>

        <!-- 5. Cash count label: "Cash Count" → "Cash counted in the drawer" -->
        <xpath expr="//div[@t-if='pos.config.cash_control'][@class='mb-3']/label" position="replace">
            <label class="form-label">Cash counted in the drawer</label>
        </xpath>

        <!-- 6. Hide Customer Account in the count section -->
        <xpath expr="//div[@t-foreach='props.non_cash_payment_methods'][@t-as='pm'][t[@t-if='_showDiff']]" position="attributes">
            <attribute name="t-if">pm.type !== 'pay_later'</attribute>
        </xpath>

        <!-- 7. Card count label: "[pm.name] Count" → "Card amount (payment terminal Z report)" -->
        <xpath expr="//div[@t-foreach='props.non_cash_payment_methods'][@t-as='pm'][t[@t-if='_showDiff']]/t[@t-if='_showDiff']/span" position="replace">
            <span>Card amount (payment terminal Z report)</span>
        </xpath>

        <!-- 8. Opening note: relabel the system-generated "Opening details:" -->
        <xpath expr="//textarea[contains(@class,'opening-notes')]/t[@t-esc='props.opening_notes']" position="replace">
            <t t-esc="displayOpeningNotes" />
        </xpath>

        <!-- 9. "Discard" button → "Back to the register" -->
        <xpath expr="//button[@t-on-click='cancel']" position="replace">
            <button class="button btn btn-secondary" t-att-disabled="!canCancel()" t-on-click="cancel" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'">Back to the register</button>
        </xpath>

        <!-- 10. "Cash In/Out" button → "Cash movement" -->
        <xpath expr="//button[@t-on-click='() => this.cashMove()']" position="replace">
            <button class="button btn btn-secondary" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'" t-on-click="() => this.cashMove()">Cash movement</button>
        </xpath>

    </t>

</templates>
