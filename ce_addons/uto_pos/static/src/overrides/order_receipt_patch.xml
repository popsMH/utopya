<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="uto_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

        <!-- White label: "Powered by Odoo" → "Powered by Optilane" -->
        <xpath expr="//p[text()='Powered by Odoo']" position="replace">
            <p>Powered by Optilane</p>
        </xpath>

        <!-- Semantics: "00026-001-0002" → "Ticket No. 00026-001-0002" -->
        <xpath expr="//div[@t-esc='props.data.name']" position="replace">
            <div>Ticket No. <t t-esc="props.data.name" /></div>
        </xpath>

    </t>

</templates>
