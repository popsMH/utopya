<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="uto_pos.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">

        <!-- "Print Full Receipt" → "Imprimer le ticket" -->
        <xpath expr="//button[contains(@t-on-click,'doFullPrint.call')]" position="replace">
            <button class="button print btn btn-lg btn-secondary w-100 py-3" t-on-click="() => doFullPrint.call()">
                <i t-attf-class="fa {{doFullPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1" />Imprimer le ticket
            </button>
        </xpath>

        <!-- "New Order" (desktop) → "Nouveau ticket" -->
        <xpath expr="//button[@name='done']" position="replace">
            <button class="button next validation btn btn-primary btn-lg w-100 py-4 lh-lg" t-att-class="{ highlight: !locked }" t-if="!splittedOrder" t-on-click="orderDone" name="done">
                Nouveau ticket
            </button>
        </xpath>

        <!-- "New Order" (mobile) → "Nouveau ticket" -->
        <xpath expr="//div[@name='done']" position="replace">
            <div class="btn-switchpane validation-button btn btn-primary btn-lg py-3 flex-fill lh-lg" t-att-class="{ highlight: !locked }" t-if="!splittedOrder" t-on-click="orderDone" name="done">
                Nouveau ticket
            </div>
        </xpath>

    </t>

</templates>
