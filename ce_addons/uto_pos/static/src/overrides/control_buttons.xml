<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Single inheritance on point_of_sale.ControlButtons.
        Thanks to the pos_sale dependency, its extension (Quotation/Order) is already
        compiled into the template before uto_pos is applied.
    -->
    <t t-name="uto_pos.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <!-- Hide the "Internal Note" button from the main bar (OrderlineNoteButton with getter) -->
        <xpath expr="//t[OrderlineNoteButton[@getter]]" position="replace"/>
        <!-- Hide "General Note" in the Actions modal -->
        <xpath expr="//div[contains(@class,'control-buttons-modal')]/OrderlineNoteButton[@label]" position="replace"/>
        <!-- Hide Pricelist -->
        <xpath expr="//button[contains(@class,'o_pricelist_button')]" position="replace"/>
        <!-- Rename "Quotation/Order" (added by pos_sale) → "Import Quotation" -->
        <xpath expr="//button[contains(@t-on-click,'onClickQuotation')]" position="replace">
            <button t-att-class="buttonClass" t-on-click="() => this.onClickQuotation()">
                <i class="fa fa-link me-1" role="img" aria-label="Import Quotation" title="Import Quotation"/> Import Quotation
            </button>
        </xpath>
        <!-- Rename "Cancel Order" → "Cancel the payment" -->
        <xpath expr="//button[contains(@t-on-click,'onDeleteOrder')]" position="replace">
            <button class="btn btn-secondary btn-lg py-5" t-on-click="() => this.pos.onDeleteOrder(this.pos.get_order())">
                <i class="fa fa-trash me-1" role="img"/> Cancel the payment
            </button>
        </xpath>
    </t>

</templates>
