<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="uto_pos.OpeningControlPopup" t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">

        <!-- 1. Title: "Opening Control" → "Register Opening" -->
        <xpath expr="//h4[contains(@class,'modal-title')]" position="replace">
            <h4 class="modal-title text-break">Register Opening</h4>
        </xpath>

        <!-- 2. Cash label: "Opening cash" → "Opening Cash (Cash)" -->
        <xpath expr="//div[contains(@class,'opening-cash-section')]/label" position="replace">
            <label class="form-label">Opening Cash (Cash)</label>
        </xpath>

        <!-- 3. Note label: "Opening note" -->
        <xpath expr="//label[@for='openingNotes']" position="replace">
            <label class="form-label" for="openingNotes">Opening note</label>
        </xpath>

        <!-- 4. Confirmation button: "Open Register" → "Open the register" -->
        <xpath expr="//button[contains(@class,'btn-primary')]" position="replace">
            <button class="button btn btn-lg btn-primary"
                t-on-click="confirm"
                t-att-disabled="!env.utils.isValidFloat(state.openingCash)">
                Open the register
            </button>
        </xpath>

        <!--
            5. "Discard" button → "Back":
            Deletes the current session (opening_control state) via pos.closePos()
            then redirects to the main menu (/odoo/home).
            This makes it impossible to reach the sales screen without declaring the opening cash.
        -->
        <xpath expr="//button[contains(@class,'backend-button')]" position="replace">
            <button class="button btn btn-lg btn-secondary"
                t-on-click="() => this.pos.closePos()">
                Back
            </button>
        </xpath>

    </t>

</templates>
