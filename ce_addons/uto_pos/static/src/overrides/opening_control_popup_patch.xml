<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="uto_pos.OpeningControlPopup" t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">

        <!-- 1. Titre : "Opening Control" → "Ouverture de la Caisse" -->
        <xpath expr="//h4[contains(@class,'modal-title')]" position="replace">
            <h4 class="modal-title text-break">Ouverture de la Caisse</h4>
        </xpath>

        <!-- 2. Label espèces : "Opening cash" → "Fond de Caisse (Espèces)" -->
        <xpath expr="//div[contains(@class,'opening-cash-section')]/label" position="replace">
            <label class="form-label">Fond de Caisse (Espèces)</label>
        </xpath>

        <!-- 3. Label note : "Opening note" → "Note d'ouverture" -->
        <xpath expr="//label[@for='openingNotes']" position="replace">
            <label class="form-label" for="openingNotes">Note d'ouverture</label>
        </xpath>

        <!-- 4. Bouton confirmation : "Open Register" → "Ouvrir la caisse" -->
        <xpath expr="//button[contains(@class,'btn-primary')]" position="replace">
            <button class="button btn btn-lg btn-primary"
                t-on-click="confirm"
                t-att-disabled="!env.utils.isValidFloat(state.openingCash)">
                Ouvrir la caisse
            </button>
        </xpath>

        <!--
            5. Bouton "Discard" → "Retour" :
            Supprime la session en cours (état opening_control) via pos.closePos()
            puis redirige vers le menu principal (/odoo/home).
            Il est ainsi impossible d'accéder à l'écran de vente sans déclarer le fond de caisse.
        -->
        <xpath expr="//button[contains(@class,'backend-button')]" position="replace">
            <button class="button btn btn-lg btn-secondary"
                t-on-click="() => this.pos.closePos()">
                Retour
            </button>
        </xpath>

    </t>

</templates>
