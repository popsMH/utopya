<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_account_journal_form_inherit" model="ir.ui.view">
        <field name="name">account.journal.form.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='default_account_id']" position="after">
                <field name="is_repair_bonus" />
            </xpath>

        </field>
    </record>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="is_linked_to_ecosystem_eligible_repair" invisible="1" />
                <field name="is_linked_to_repair_order_phone" invisible="1" />
                <field name="ro_name" invisible="1" />
                <field name="ro_product_to_repair_brand" invisible="1" />
                <field name="ro_product_to_repair_device" invisible="1" />
                <field name="ro_product_to_repair_device_id" invisible="1" />
            </xpath>

            <xpath expr="//page[@id='other_tab']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//page[@id='other_tab_entry']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

        </field>
    </record>

    <record id="account.action_move_out_invoice" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_invoice_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="attributes">
                <attribute name="string">Total excluding tax</attribute>
            </xpath>

            <xpath expr="//field[@name='amount_total_in_currency_signed'][1]" position="attributes">
                <attribute name="string">Total including tax</attribute>
            </xpath>

            <xpath expr="//field[@name='amount_total_in_currency_signed'][2]" position="attributes">
                <attribute name="string">Total including tax</attribute>
            </xpath>

        </field>
    </record>

</odoo>