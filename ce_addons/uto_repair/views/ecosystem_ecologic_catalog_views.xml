<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- catalog -->
    <record id="view_ecosystem_ecologic_catalog_form" model="ir.ui.view">
        <field name="name">ecosystem.ecologic.catalog.form</field>
        <field name="model">ecosystem.ecologic.catalog</field>
        <field name="arch" type="xml">
            <form string="Catalog" delete="1" duplicate="0" create="0">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="name" />
                        <field name="is_serial_tag_required"/>
                        <field name="is_piece_uthorized"/>
                        <field name="catalog_type" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ecosystem_ecologic_catalog_list" model="ir.ui.view">
        <field name="name">ecosystem.ecologic.catalog.list</field>
        <field name="model">ecosystem.ecologic.catalog</field>
        <field name="arch" type="xml">
            <list string="Catalog" delete="1" duplicate="0" edit="0" create="0">
                <field name="product_id"/>
                <field name="name"/>
                <field name="catalog_type" />
            </list>
        </field>
    </record>

    <record id="view_ecosystem_ecologic_catalog_search" model="ir.ui.view">
        <field name="name">ecosystem.ecologic.catalog.search</field>
        <field name="model">ecosystem.ecologic.catalog</field>
        <field name="arch" type="xml">
            <search string="Catalog">
                <field name="product_id"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_ecosystem_ecologic_catalog" model="ir.actions.act_window">
        <field name="name">Catalog</field>
        <field name="res_model">ecosystem.ecologic.catalog</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new Catalog
            </p>
        </field>
    </record>

    <menuitem id="repair_menu_ecosystem_ecologic_catalog" name="Catalog" parent="repair.repair_menu_config" action="action_ecosystem_ecologic_catalog" sequence="100" active="False"/>

</odoo>