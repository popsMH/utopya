<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<template id="report_invoice_include_bonus" inherit_id="account.report_invoice_document">

			<xpath expr="//t[@t-set='layout_document_title']" position="replace">
				<t t-set="layout_document_title">
					<span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
					<span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
					<span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
					<span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Credit Note</span>
					<span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note</span>
					<span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note</span>
					<span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
					<span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>
					<span t-if="o.name and o.name != '/'" t-field="o.name">INV/2023/0001</span>
				</t>
			</xpath>

			<xpath expr="//div[@id='informations']" position="after">
				<div class="oe_structure"></div>
				<div
					id="informations" class="row mb-4"
					t-if="o.move_type == 'out_invoice' and o.state == 'posted' and o.is_linked_to_repair_order_phone">
					<div class="col" name="ro_name">
						<strong>Repair Order</strong>
						<div t-field="o.ro_name">WH/RO/00001x</div>
					</div>
					<div class="col" name="ro_product_to_repair_brand">
						<strong>Brand</strong>
						<div t-field="o.ro_product_to_repair_brand">Phone</div>
					</div>
					<div class="col" name="ro_product_to_repair_device">
						<strong>Device</strong>
						<div t-field="o.ro_product_to_repair_device">Iphone 12</div>
					</div>
					<div class="col" name="ro_product_to_repair_device_id">
						<strong>Device ID</strong>
						<div t-field="o.ro_product_to_repair_device_id">1234DFG345</div>
					</div>
				</div>
			</xpath>

			<xpath expr="//t[@t-if='print_with_payments']" position="replace">
				<!--Payments-->
				<t t-if="print_with_payments">
					<t t-if="o.is_linked_to_ecosystem_eligible_repair">
						<t t-if="o.payment_state != 'invoicing_legacy'">
							<t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
							<t t-if="payments_vals">
								<!-- <t t-set="payments_vals_bonus" t-value="payments_vals[0]"/> -->
								<!-- <t t-set="payments_vals_bonus" t-value="payments_vals.filtered(lambda payment: payment.is_journal_repair_bonus)"/> -->
								<t t-set="payments_vals_bonus_list" t-value="[payment for payment in payments_vals if payment.get('is_journal_repair_bonus')]"/>
								<t t-set="other_payments_vals" t-value="[payment for payment in payments_vals if not payment.get('is_journal_repair_bonus')]"/>
								<t t-if="payments_vals_bonus_list">
									<t t-set="payments_vals_bonus" t-value="payments_vals_bonus_list[0]"/>
								
									<t t-set="tax_totals" t-value="o.tax_totals"/>
									<t t-if="payments_vals_bonus">
										<tr>
											<td>
												<t>Repair bonus </t>
												<span>(</span>
												<t t-out="payments_vals_bonus['date']" t-options='{"widget": "date"}'>2021-09-19</t>
												<span>)</span>
											</td>
											<td class="text-end">
												<span t-out="payments_vals_bonus['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>20.00</span>
											</td>
										</tr>
										<tr>
											<td>
												<t>Net Amount </t>
											</td>
											<td class="text-end">
												<span t-out="tax_totals['total_amount_currency'] - payments_vals_bonus['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>20.00</span>
											</td>
										</tr>
									</t>
								</t>
								<t t-if="other_payments_vals">
									<t t-foreach="other_payments_vals" t-as="other_payment_vals">
										<tr t-if="other_payment_vals['is_exchange'] == 0">
											<td>
												<t>Paid on </t>
												<t t-out="other_payment_vals['date']" t-options='{"widget": "date"}'>2021-09-19 </t>
												<t t-out="other_payment_vals['journal_name']"> </t>
											</td>
											<td class="text-end">
												<span t-out="other_payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>20.00</span>
											</td>
										</tr>
									</t>
								</t>
							</t>
							<t t-if="len(payments_vals) > 0">
								<tr class="fw-bold">
									<td>Solde</td>
									<td class="text-end">
										<span t-field="o.amount_residual">11.05</span>
									</td>
								</tr>
							</t>
						</t>
					</t>
					<t t-else="">
						<t t-if="o.payment_state != 'invoicing_legacy'">
							<t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
							<t t-foreach="payments_vals" t-as="payment_vals">
								<tr t-if="payment_vals['is_exchange'] == 0">
									<td>
										<i class="oe_form_field text-end oe_payment_label">
											<t t-if="payment_vals['is_refund']">Reversed on </t>
											<t t-else="">Paid on </t>
											<t t-out="payment_vals['date']" t-options='{"widget": "date"}'>2021-09-19</t>
										</i>
									</td>
									<td class="text-end">
										<span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>20.00</span>
									</td>
								</tr>
							</t>
							<t t-if="len(payments_vals) > 0">
								<tr class="fw-bold">
									<td>Amount Due</td>
									<td class="text-end">
										<span t-field="o.amount_residual">11.05</span>
									</td>
								</tr>
							</t>
						</t>
					</t>
				</t>
			</xpath>
		</template>

	</data>
</odoo>