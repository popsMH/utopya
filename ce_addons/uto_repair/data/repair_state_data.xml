<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record model="repair.state" id="state_1" forcecreate="True">
        <field name="name">To be diagnosed</field>
        <field name="sequence">1</field>
    </record>
    <record model="repair.state" id="state_2" forcecreate="True">
        <field name="name">Quotation Validation</field>
        <field name="sequence">2</field>
    </record>
    <record model="repair.state" id="state_3" forcecreate="True">
        <field name="name">Waiting For Parts</field>
        <field name="sequence">3</field>
    </record>
    <record model="repair.state" id="state_4" forcecreate="True">
        <field name="name">Under Repair</field>
        <field name="sequence">4</field>
    </record>
    <record model="repair.state" id="state_5" forcecreate="True">
        <field name="name">Ready / Awaiting customer</field>
        <field name="sequence">5</field>
    </record>
    <record model="repair.state" id="state_6" forcecreate="True">
        <field name="name">Completed / Returned</field>
        <field name="sequence">6</field>
        <field name="is_unclickable">True</field>
        <field name="is_done">True</field>
    </record>
    <record model="repair.state" id="state_7" forcecreate="True">
        <field name="name">Cancelled / Not repairable</field>
        <field name="sequence">7</field>
        <field name="is_unclickable">True</field>
        <field name="is_cancelled">True</field>
    </record>
</odoo>