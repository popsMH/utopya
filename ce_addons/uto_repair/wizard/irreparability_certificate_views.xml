<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_irreparability_certificate_wizard_form" model="ir.ui.view">
        <field name="name">repair.irreparability.certificate.wizard.form</field>
        <field name="model">repair.irreparability.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Irreparability Certificate">
                <group>
                    <field name="repair_order_id" />
                    <field name="motif_irreparabilite" required="1" />
                    <field name="motif_irreparabilite_autre" 
                        invisible="motif_irreparabilite != 'autre'" 
                        required="motif_irreparabilite == 'autre'"
                        placeholder="Describe the irreparability reason..." />
                </group>
                <footer>
                    <button name="action_generate_certificate" 
                        type="object" 
                        string="Generate and Download the Certificate" 
                        class="oe_highlight" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
