<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_irreparability_certificate_document">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <!-- Header with logo and shop information -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <t t-if="doc.company_id.logo">
                                    <img t-att-src="image_data_uri(doc.company_id.logo)" 
                                        style="max-height: 100px;" alt="Logo"/>
                                </t>
                                <h2 t-esc="doc.company_id.name" class="mt-2"/>
                                <div t-esc="doc.company_id.street"/>
                                <div>
                                    <span t-esc="doc.company_id.zip"/>
                                    <span t-esc="doc.company_id.city"/>
                                </div>
                                <div>Phone: <span t-esc="doc.company_id.partner_id.phone or doc.company_id.phone"/></div>
                                <div>Email: <span t-esc="doc.company_id.email"/></div>
                                <div>SIRET No.: <span t-esc="doc.company_id.siret or doc.company_id.vat"/></div>
                            </div>
                            <div class="col-4 text-end">
                                
                            </div>
                        </div>

                        <hr/>

                        <!-- Certificate body -->
                        <p class="mt-3"><h3>IRREPARABILITY CERTIFICATE</h3> Document No.: <strong t-esc="doc.name"/></p>
                        <div class="mt-4">
                            <p>I, the undersigned, 
                            <t t-if="doc.assigned_technician">
                                <strong t-esc="doc.assigned_technician.name"/>
                            </t>
                            <t t-else="">
                                <strong t-esc="user.name"/>
                            </t>
                            acting as a specialized technician for the company <strong t-esc="doc.company_id.name"/>,
                            hereby certify that I have examined the following device:</p>

                            <!-- Device information -->
                            <div class="row mb-4">
                                <div class="col-8">
                                    <div>Device type: <span t-if="doc.catalog_catalog_id" t-esc="doc.catalog_catalog_id.name"/><span t-else="" t-esc="doc.other_product_to_repair"/></div>
                                    <div>Brand: <span t-if="doc.brand_brand_id" t-esc="doc.brand_brand_id.name"/></div>
                                    <div>Model: <span t-esc="doc.commercial_reference"/></div>
                                    <div>Serial Number / IMEI: <span t-esc="doc.device_id"/></div>
                                </div>
                                <div class="col-4 text-end">
                                </div>
                            </div>

                            <!-- Customer information -->
                            <div class="mt-4">
                                <p>This device was dropped off at our workshop on <strong t-esc="doc.create_date" t-options='{"widget": "date"}'/> by:</p>
                                <ul style="list-style: none;">
                                    <li><strong t-esc="doc.partner_id.name"/></li>
                                    <li t-esc="doc.partner_id.street" t-if="doc.partner_id.street"/>
                                    <li>
                                        <span t-esc="doc.partner_id.zip" t-if="doc.partner_id.zip"/>,
                                        <span t-esc="doc.partner_id.city" t-if="doc.partner_id.city"/>
                                    </li>
                                    <li t-if="doc.partner_id.phone">Phone: <span t-esc="doc.partner_id.phone"/></li>
                                </ul>
                            </div>

                            <!-- Diagnosis result -->
                            <div class="mt-4 p-3" style="background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 4px;">
                                <h4 class="text-danger">DIAGNOSIS RESULT</h4>
                                <p>After a full technical assessment carried out on
                                <strong t-esc="doc.repair_end_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}' t-if="doc.repair_end_date"></strong>
                                <strong t-else=""><t t-esc="doc.date_certificat_irreparabilite" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></strong>,
                                we declare this device technically and/or economically irreparable.</p>

                                <div class="mt-3">
                                    <p><strong>Irreparability reason(s):</strong></p>
                                    <p class="mb-0" t-if="doc.motif_irreparabilite">
                                        <span t-field="doc.motif_irreparabilite"/>
                                    </p>
                                    <p t-if="doc.motif_irreparabilite_autre" class="mt-2">
                                        <em t-esc="doc.motif_irreparabilite_autre"/>
                                    </p>
                                </div>
                            </div>

                            <!-- Conclusion -->
                            <div class="mt-4">
                                <p>Consequently, any repair work is impossible or unjustified. The device is returned to the customer as is 
                                (or sent to a WEEE recycling channel at the customer's request). This certificate is issued in a single copy, to serve 
                                and avail as required by law, in particular with insurance companies for the filing of a claim.</p>
                            </div>

                            <!-- Signature -->
                            <div class="row mt-5">
                                <div class="col-6">
                                    <p>Done at <t t-set="company_city" t-value="doc.company_id.partner_id.city or doc.company_id.city"/><t t-if="company_city"><span t-esc="company_city"/></t><t t-else=""><span style="display:inline-block; min-width:160px; border-bottom:1px solid #000;">&#160;</span></t>, on <span t-esc="doc.date_certificat_irreparabilite" t-options='{"widget": "date", "format": "dd/MM/yyyy"}' t-if="doc.date_certificat_irreparabilite"></span>.</p>
                                </div>
                                <div class="col-6 text-end">
                                    <p style="min-height: 80px; border-top: 1px solid #000;">Technician's signature and company stamp</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_irreparability_certificate" model="ir.actions.report">
        <field name="name">Irreparability Certificate</field>
        <field name="model">repair.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">uto_repair.report_irreparability_certificate_document</field>
        <field name="report_file">uto_repair.report_irreparability_certificate_document</field>
        <field name="print_report_name">'Irreparability_Certificate_%s' % object.name</field>
        <field name="binding_model_id" ref="model_repair_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="uto_repair.paperformat_irreparability"/>
    </record>
</odoo>
