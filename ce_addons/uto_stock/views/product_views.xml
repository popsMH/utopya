<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_product_template_tree_inherit" model="ir.ui.view">
        <field name="name">product.template.stock.list.inherit.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='show_on_hand_qty_status_button']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='qty_available']" position="replace">
                <field name="qty_available" invisible="not show_on_hand_qty_status_button" string="Stock" decoration-danger="qty_available &lt; 0" groups="stock.group_stock_user"/>
            </xpath>

            <xpath expr="//field[@name='virtual_available']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='responsible_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_pos_product_template_tree_inherit" model="ir.ui.view">
        <field name="name">product.template.pos.list.inherit.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='pos_categ_ids']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='available_in_pos']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

        </field>
    </record>

    <record id="product_template_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.template.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="attributes">
                <attribute name="string">Product</attribute>
                <attribute name="multi_edit">1</attribute>
                <attribute name="sample">1</attribute>
            </xpath>

            <xpath expr="//list" position="inside">
                <header>
                    <button string="Print Labels" type="object" name="action_open_label_layout"/>
                </header>
            </xpath>

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Product Name</attribute>
            </xpath>

            <xpath expr="//field[@name='is_favorite']" position="replace">
                <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
            </xpath>

            <xpath expr="//field[@name='default_code']" position="replace">
                <field name="default_code" string="Reference"/>
            </xpath>

            <xpath expr="//field[@name='product_tag_ids']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='barcode']" position="replace">
                <field name="barcode" readonly="product_variant_count != 1"/>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='list_price']" position="replace">
                <field name="list_price" string="Price Incl. Taxes" widget='monetary' options="{'currency_field': 'currency_id'}" decoration-muted="not sale_ok"/>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="replace">
                <field name="categ_id" />
            </xpath>

            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='uom_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='activity_exception_decoration']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

        </field>
    </record>

    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.extend</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_policy']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='product_tooltip']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_template_property_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.property.inherit.extend</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='is_storable']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tracking']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="product_template_account_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.product.form.inherit.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='supplier_taxes_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

