<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_occasion_trade_in" model="ir.ui.view">
        <field name="name">res.company.form.occasion.trade.in</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Occasion &amp; Trade-In" name="occasion_trade_in">
                    <group string="Taxation (VAT on Margin)">
                        <field name="is_margin_vat" widget="boolean_toggle"/>
                        <field name="margin_vat_legal_mention" invisible="not is_margin_vat"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
