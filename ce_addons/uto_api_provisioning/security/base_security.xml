<?xml version="1.0"?>
<odoo>
    <data noupdate="0">

        <record id="uto_group_company_main_user_rule" model="ir.rule">
            <field name="name">Main User sees only its company</field>
            <field name="model_id" ref="model_res_company"/>
            <field name="groups" eval="[Command.link(ref('uto_api_provisioning.group_company_main_user'))]"/>
            <field name="domain_force">[
                ('id', 'in', user.company_ids.ids)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
